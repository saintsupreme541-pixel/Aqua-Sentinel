# AQUA-SENTINEL frontend configuration (copy to .env.local and adjust).

# Base URL of the FastAPI backend. Leave EMPTY in development if you use the
# Vite dev-server proxy (vite.config.ts) — set it for a standalone deployment,
# e.g. VITE_API_BASE=http://127.0.0.1:8000
VITE_API_BASE=

# MapLibre style URL for the Marine Intelligence Map. Any raster/vector style
# works; the default is the free demo style (no API key required).
VITE_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
