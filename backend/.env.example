# AQUA-SENTINEL backend configuration (copy to .env and adjust).
# All fields optional — sensible defaults are used when absent.

# --- server -----------------------------------------------------------
AQUA_HOST=0.0.0.0
AQUA_PORT=8000

# --- storage ----------------------------------------------------------
# Runtime data (SQLite DB, raw/processed images, reports). Created if missing.
AQUA_STORAGE_DIR=
AQUA_DB_PATH=

# --- upload limits ----------------------------------------------------
AQUA_MAX_UPLOAD_SIZE=52428800

# --- model registry ---------------------------------------------------
# Points at models/registry.json by default. Trained weights are optional:
# missing weights fall back to the deterministic heuristic baseline, which
# is always clearly labeled in the API/UI (never presented as trained AI).
AQUA_MODEL_REGISTRY=
# YOLO_MODEL_PATH / UNET / CLASSIFIER paths live in models/registry.json

# --- pipeline ---------------------------------------------------------
AQUA_PREPROCESS_PRESET=light
AQUA_MAX_WORKERS=2

# --- evidence fusion (documented, tunable prototype weights) ----------
AQUA_FUSION_GAIN=3.2
AQUA_FUSION_INTERCEPT=-0.4
AQUA_CONFIRM_THRESHOLD=0.63
AQUA_REVIEW_THRESHOLD=0.45
AQUA_CONSISTENCY_DISTANCE_M=25.0

# --- sample data ------------------------------------------------------
AQUA_SAMPLE_DATA=
